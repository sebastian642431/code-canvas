title: A file with unsaved text that another program changes takes what the other wrote into the text, and saving writes both
folders: edit-odd
limit: 40
forbid-log: cannot edit
forbid-log: WARN.*script
expect-file: edit-odd/a.txt :: (?-i)THEIRS
expect-file: edit-odd/a.txt :: (?-i)\AMINE
expect-log: saved .*a\.txt

wait 3000
goto a.txt
wait 800
edit a.txt 1 1
type MINE
touch a.txt THEIRS
wait 2500
mark both-on-the-card
wait 400
key save
wait 1000
mark saved-with-both
wait 400
quit
