title: An interactive rebase from the first commit after the base: two rows reordered, one squashed, one reworded with quotes, one dropped
folders: git-rebase
expect-file: git-rebase/.git/logs/HEAD :: rebase [(]finish[)]: returning to refs/heads/main
expect-file: git-rebase/.git/logs/HEAD :: rebase [(]squash[)]
expect-file: git-rebase/.git/logs/HEAD :: commit [(]amend[)]: Say "hi" it.s [$]HOME
expect-file: git-rebase/c4.txt :: commit 4
expect-file: git-rebase/c2.txt :: commit 2
absent-file: git-rebase/c3.txt
forbid-log: WARN.*script

wait 3500
left changes
wait 1500
palette Open All Commits
wait 500
press enter
wait 2500
ui right 1100 252
wait 1000
mark a-menu
wait 500
ui click 1220 424
wait 1500
mark b-card
wait 500
wait 500
ui drag 1158 250 1158 221
wait 1000
mark c-reordered
wait 500
ui click 1213 189
wait 800
mark d-picker
wait 500
wait 500
ui click 1232 275
wait 800
rebase action 4 drop
wait 300
rebase reword 3 Say "hi" it's $HOME
wait 800
mark e-plan
wait 500
ui click 1186 848
wait 3500
mark f-done
wait 500
ui click 95 388
wait 800
ui right 150 435
wait 800
mark g-reflog
wait 500
quit
